<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Day / non-night: aligns with Compose KineticEcoTheme light (cold start before first frame) -->
    <style name="Theme.KineticEcoTracker" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">@color/green_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/theme_secondary_neutral</item>
        <item name="colorSecondaryVariant">@color/theme_secondary_neutral</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/kinetic_light_background</item>
        <item name="colorSurface">@color/kinetic_light_surface</item>
        <item name="colorOnSurface">#1a1a1a</item>
        <item name="android:statusBarColor">@color/kinetic_light_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/kinetic_light_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/kinetic_light_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
