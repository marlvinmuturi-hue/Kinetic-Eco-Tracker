<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night: aligns with Compose KineticEcoTheme dark -->
    <style name="Theme.KineticEcoTracker" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">@color/green_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/theme_secondary_neutral</item>
        <item name="colorSecondaryVariant">@color/theme_secondary_neutral</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/kinetic_dark_background</item>
        <item name="colorSurface">@color/kinetic_dark_surface</item>
        <item name="colorOnSurface">#ededed</item>
        <!-- statusBarColor / navigationBarColor removed: deprecated & ignored under
             edge-to-edge (Android 15). windowBackground provides the cold-start color;
             bar icon contrast is set at runtime via WindowInsetsController. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/kinetic_dark_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
