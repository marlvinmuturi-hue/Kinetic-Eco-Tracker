rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User documents ──────────────────────────────────────────────────────
    // Each user may read/write only their own top-level document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sessions: only the owning user may read/write.
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Any per-session subcollections (e.g. accelerometer sample batches)
        // are owned by the same user.
        match /{document=**} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // FCM tokens: device registers its own token; Cloud Functions read all.
      // Deletion is also allowed by the owning user (e.g. on logout).
      match /fcmTokens/{tokenId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Premium entitlement: the owner may read their own, and no client may
      // write one. Purchases are verified server-side against the Play Developer
      // API and written with the Admin SDK, which bypasses these rules entirely.
      // A client that can write its own entitlement has no paywall at all.
      match /entitlements/{entitlementId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // ── Top-level sessions (legacy / backward-compat) ────────────────────────
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
    }

    // ── Feedback ─────────────────────────────────────────────────────────────
    // Any authenticated user may submit feedback; nobody reads it from the client
    // (admins use the Firebase Console / Admin SDK).
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ── Leaderboard ───────────────────────────────────────────────────────────
    // Authenticated clients may read the full leaderboard.
    // Each user may create/update/delete only their own entry.
    //
    // NOTE: LeaderboardService.writeLeaderboardEntry writes PER-WINDOW SUFFIXED
    // fields (score1d..score366d/scoreAllTime, co2Conserved<suffix>,
    // totalDistance<suffix> [metres], totalSessions<suffix>, etc.) plus userId,
    // displayName, photoUrl, lastUpdated. It does NOT write bare `co2Saved`,
    // `totalDistanceKm`, or `totalSessions` fields — the previous rule validated
    // those, so every client write was denied (leaderboard read zero; opt-in
    // aborted before creating the user doc). We validate ownership + the fields
    // the client actually writes, with optional "absent-or-valid" sanity bounds
    // on the headline all-time aggregates so legitimate writes are never blocked.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.userId == userId &&
        request.resource.data.displayName is string &&
        request.resource.data.lastUpdated is number &&
        // co2ConservedAllTime is kg and may be negative (net emissions). Optional.
        (!('co2ConservedAllTime' in request.resource.data) ||
          (request.resource.data.co2ConservedAllTime is number &&
           request.resource.data.co2ConservedAllTime >= -100000 &&
           request.resource.data.co2ConservedAllTime <= 100000)) &&
        // totalDistanceAllTime is METRES (not km). Cap at 100,000 km. Optional.
        (!('totalDistanceAllTime' in request.resource.data) ||
          (request.resource.data.totalDistanceAllTime is number &&
           request.resource.data.totalDistanceAllTime >= 0 &&
           request.resource.data.totalDistanceAllTime <= 100000000)) &&
        (!('totalSessionsAllTime' in request.resource.data) ||
          (request.resource.data.totalSessionsAllTime is number &&
           request.resource.data.totalSessionsAllTime >= 0 &&
           request.resource.data.totalSessionsAllTime <= 1000000));

      // Reactions: each user controls only their own reaction sub-document.
      match /reactions/{reactorUserId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null &&
          request.auth.uid == reactorUserId;
      }
    }

    // ── Daily leaderboard cache (read via Cloud Function only) ──────────────
    // The dailyLeaderboardTop function reads/writes via Admin SDK. Direct
    // client access is unnecessary and disallowed.
    match /leaderboardDaily/{dateKey}/users/{userId} {
      allow read, write: if false;
    }

    // ── Analysis cache & rate limit (managed by Cloud Functions only) ───────
    match /analysisCache/{userId} {
      allow read, write: if false;
    }
    match /analysisRateLimit/{userId} {
      allow read, write: if false;
    }

    // ── Play purchase index (purchaseToken → uid) ───────────────────────────
    // Written by verifyPlayPurchase so a real-time developer notification, which
    // identifies a purchase but not a user, can find whose entitlement to update.
    // Client-readable it would leak purchase tokens; client-writable it would let
    // anyone claim someone else's purchase. Cloud Functions bypass these rules.
    match /playPurchases/{purchaseToken} {
      allow read, write: if false;
    }
  }
}
