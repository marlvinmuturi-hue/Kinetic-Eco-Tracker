<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include Room database (session history only — no auth data) -->
    <include domain="database" path="app_database" />

    <!-- Include only non-sensitive preferences (unit system, theme, display prefs) -->
    <include domain="sharedpref" path="user_preferences.xml" />

    <!-- Everything else (auth tokens, Firebase session state, WebView storage)
         is implicitly excluded since only the paths above are included. -->
</full-backup-content>